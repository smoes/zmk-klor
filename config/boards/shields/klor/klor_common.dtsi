/*
 * KLOR polydactyl — gemeinsame Definitionen beider Haelften
 *
 * Abgeleitet von GEIGEIGEIST/zmk-config-klor (MIT).
 * Entfernt gegenueber dem Original: OLED-Node und chosen zephyr,display.
 * Der I2C-Bus bleibt aktiv — er versorgt jetzt das Trackpad.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &default_transform;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "col2row";
	};

	/*
	 * Nur die linke Haelfte bekommt einen Encoder. Die rechte Position
	 * ist vom Trackpad belegt, deshalb ist hier — anders als im Original —
	 * kein right_encoder definiert.
	 */
	left_encoder: encoder_left {
		compatible = "alps,ec11";
		steps = <80>;
		status = "disabled";
	};

	sensors: sensors {
		compatible = "zmk,keymap-sensors";
		sensors = <&left_encoder>;
		triggers-per-rotation = <20>;
	};
};
